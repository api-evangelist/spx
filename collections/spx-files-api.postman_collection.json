                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"files\": [\n    \"logo.png\",\n    \"background.jpg\",\n    \"overlay.mp4\"\n  ]\n}",
              "cookie": [],
