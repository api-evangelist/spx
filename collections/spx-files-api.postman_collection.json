          "id": "732981cf-2d5f-4061-9bdd-e0b4c274d35f",
          "name": "Get File List",
          "request": {
            "name": "Get File List",
            "description": {
              "content": "Returns a list of files from a given subfolder within the ASSETS folder of the SPX installation. Useful for populating template dropdowns or media selection UIs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "getFileList"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "folder",
                  "value": "<string>",
                  "description": "(Required) Subfolder path relative to the ASSETS directory"
                },
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "API key for authentication. Required only if the SPX configuration has an apikey value set. Leave empty if no restriction is configured."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "50674e73-9ed2-40f5-a71a-4ea27c188837",
              "name": "File list returned",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "getFileList"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
