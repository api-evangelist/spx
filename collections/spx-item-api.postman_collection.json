        {
          "id": "9dad609b-9337-4edd-8fc8-51e9f4d58170",
          "name": "Direct Play Out",
          "request": {
            "name": "Direct Play Out",
            "description": {
              "content": "Executes a direct play, continue, or stop command to a template without requiring the item to be in the current rundown. Introduced in v1.0.12. Useful for triggering graphics directly from external systems.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "directplayout"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
