        {
          "id": "97c89245-d7af-4e67-8e20-f00c38258237",
          "name": "Update Item",
          "request": {
            "name": "Update Item",
            "description": {
              "content": "Updates the data fields of a specific rundown item. Can be used to change text, images, or other template variables programmatically.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "item",
                "update"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "API key for authentication. Required only if the SPX configuration has an apikey value set. Leave empty if no restriction is configured."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project\": \"<string>\",\n  \"rundown\": \"<string>\",\n  \"item\": \"<integer>\",\n  \"fields\": [\n    {\n      \"field\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"field\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
